s://api.github.com/users/spron-in/orgs","repos_url":"https://api.github.com/users/spron-in/repos","events_url":"https://api.github.com/users/spron-in/events{/privacy}","received_events_url":"https://api.github.com/users/spron-in/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":0,"created_at":"2026-08-10T02:48:47Z","updated_at":"2026-08-10T02:49:21Z","closed_at":null,"assignee":{"login":"spron-in","id":11819154,"node_id":"MDQ6VXNlcjExODE5MTU0","avatar_url":"https://avatars.githubusercontent.com/u/11819154?v=4","gravatar_id":"","url":"https://api.github.com/users/spron-in","html_url":"https://github.com/spron-in","followers_url":"https://api.github.com/users/spron-in/followers","following_url":"https://api.github.com/users/spron-in/following{/other_user}","gists_url":"https://api.github.com/users/spron-in/gists{/gist_id}","starred_url":"https://api.github.com/users/spron-in/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/spron-in/subscriptions","organizations_url":"https://api.github.com/users/spron-in/orgs","repos_url":"https://api.github.com/users/spron-in/repos","events_url":"https://api.github.com/users/spron-in/events{/privacy}","received_events_url":"https://api.github.com/users/spron-in/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### What is the issue?\n\nA `clusterDetailTab` scoped with `providers: [percona-server-mongodb]` in the Plugin CR still shows on all engines. The host renders extensions from the bundle's `registerExtension()` calls, and `plugins.context.tsx` only reads type and sidebarItem icon from the CR descriptor - providers (and other fields) are dropped, so db-`cluster-details.tsx` filters on an undefined value and defaults to \"show everywhere.\"\n\n### Steps to Reproduce\n\nDeploy the plugin with CR restriction to a specific provider. As a result the plugin will be visible in all extension points for all providers. \n\n### Relevant Logs / Output\n\n_No response_\n\n### OpenEverest Version\n\nv2.0.0\n\n### Installation Method\n\nHelm\n\n### Kubernetes Distribution\n\nGKE\n\n### Environment Details\n\n_No response_\n\n### Possible Solution\n\nFix in the openeverest core: `PluginProvider` should merge CR extension-point metadata onto the registered extension. Workaround: set providers in the bundle and rebuild.\n\n### Additional Context\n\n_No response_","closed_by":null,"reactions":{"url":"https://api.github.com/repos/openeverest/openeverest/issues/2846/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/openeverest/openeverest/issues/2846/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null},{"url":"https://api.github.com/repos/openeverest/openeverest/issues/2845","repository_url":"https://api.github.com/repos/openeverest/openeverest","labels_url":"https://api.github.com/repos/openeverest/openeverest/issues/2845/labels{/name}","comments_url":"https://api.github.com/repos/openeverest/openeverest/issues/2845/comments","events_url":"https://api.github.com/repos/openeverest/openeverest/issues/2845/events","html_url":"https://github.com/openeverest/openeverest/pull/2845","id":5106101248,"node_id":"PR_kwDOLA3Si878zSZl","number":2845,"title":"chore(plugin-sdk): bump version to 0.2.0","user":{"login":"spron-in","id":11819154,"node_id":"MDQ6VXNlcjExODE5MTU0","avatar_url":"https://avatars.githubusercontent.com/u/11819154?v=4","gravatar_id":"","url":"https://api.github.com/users/spron-in","html_url":"https://github.com/spron-in","followers_url":"https://api.github.com/users/spron-in/followers","following_ur