{
  "name": "@openeverest/plugin-theme",
  "version": "0.1.0",
  "description": "Themes an OpenEverest plugin's own MUI from the host design tokens (--everest-* CSS variables), so plugins look native and stay independent of the host's MUI version.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openeverest/openeverest.git",
    "directory": "ui/packages/plugin-theme"
  },
  "main": "dist/esm/index.js",
  "module": "dist/esm/index.js",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "rm-build-dir": "rm -rf dist",
    "build": "rollup -c",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@emotion/cache": "^11.11.0",
    "@emotion/react": "^11.14.0",
    "@mui/material": "^5.15.0 || ^6.0.0 || ^7.0.0 || ^9.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "@emotion/cache": "^11.11.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^7.3.0",
    "@percona/tsconfig": "workspace:*",
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^11.0.0",
    "@testing-library/jest-dom": "^6.1.4",
    "@testing-library/react": "^14.0.0",
    "@types/react": "^18.2.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "jsdom": "^28.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "rollup": "^4.63.5",
    "rollup-plugin-dts": "^6.5.1",
    "typescript": "^5.2.2",
    "vitest": "^4.0.18"
  }
}
