  context=backend_dir,
  dockerfile='./everest.Dockerfile',
  target=everest_target,
  entrypoint=everest_entrypoint,
  only=['{0}/bin/everest'.format(backend_dir), '{0}/bin/manager'.format(backend_dir)],
  live_update=[
    sync('{0}/bin/everest'.format(backend_dir), '/home/everest/everest-api'),
  ]
)

# Controller image: separate Tilt-local image ref so the restart wrapper
# uses /home/everest/everest-controller instead of /home/everest/everest-api.
docker_build_with_restart(CONTROLLER_TILT_IMAGE,
  context=backend_dir,
  dockerfile='./everest.Dockerfile',
  target=everest_target,
  entrypoint=['/home/everest/everest-controller'],
  only=['{0}/bin/everest'.format(backend_dir), '{0}/bin/manager'.format(backend_dir)],
  live_update=[
    sync('{0}/bin/manager'.format(backend_dir), '/home/everest/everest-controller'),
  ]
)

