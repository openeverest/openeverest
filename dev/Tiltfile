#######################################
############ Backup Storages ##########
#######################################
def getBackupStorageNames():
    to_return = []
    for ns in config_yaml['namespaces']:
        to_return.extend([storage_name for storage_name in ns.get('backupStorages', [])])
    return to_return

if need_backup_storage:
    # Deploy SeaweedFS as backup storage
    print('Deploying SeaweedFS as backup storage')
    seaweedfs_path = os.path.realpath('{0}/resources/seaweedfs.yaml'.format(config.main_dir))
    seaweedfs_objs=read_yaml_stream(seaweedfs_path)
    bsListStr=','.join(getBackupStorageNames())
    for seaweedfs_obj in seaweedfs_objs:
        if seaweedfs_obj['kind'] == 'Deployment' and seaweedfs_obj['metadata']['name'] == 'seaweedfs':
            # Redefine the env variable with the list of bucket names
            for env in seaweedfs_obj['spec']['template']['spec']['containers'][0]['env']:
                if env['name'] == 'S3_BUCKET':
                    env['value']=bsListStr
            break
    k8s_yaml(encode_yaml_stream(seaweedfs_objs))
    k8s_resource(
        workload='seaweedfs',
        objects=[
            'seaweedfs:Namespace',
            'seaweedfs-data:PersistentVolumeClaim:seaweedfs',
            'seaweedfs-cert:Secret:seaweedfs'
        ],
        new_name='seaweedfs-deploy',
        port_forwards=[
            port_forward(9090, 8888, 'SeaweedFS Filer UI'),
        ],
        labels=["backup-storage"]
    )

    # Create BackupStorage CRs
    bs_crd_path = os.path.realpath('{0}/resources/backupstorage.yaml'.format(config.main_dir))
    for namespace in config_yaml['namespaces']:
        ns_name = namespace['name']
        for storage_name in namespace.get('backupStorages', []):
            bs_objs=read_yaml_stream(bs_crd_path)
            for obj in bs_objs:
                if obj['kind'] == 'Secret':
                    obj.update({
                        'metadata': {
                            'namespace': ns_name,
                            'name': storage_name
                        }
                    })
                elif obj['kind'] == 'BackupStorage':
                    obj.update({
                        'metadata': {
                            'namespace': ns_name,
                            'name': storage_name
                        }
                    })
                    obj['spec']['s3'].update({
                            'bucket': '{0}'.format(storage_name),
                            'credentialsSecretRef': {
                                'name': storage_name,
                            },
                    })
            k8s_yaml(encode_yaml_stream(bs_objs))
            k8s_resource(
                objects=[
                    '{0}:Secret:{1}'.format(storage_name, ns_name),
                    '{0}:BackupStorage:{1}'.format(storage_name, ns_name),
                ],
                new_name='bs-{0}-{1}'.format(ns_name, storage_name),
                labels=["backup-storage"],
                resource_deps=[
                    'crds',
                    'seaweedfs-deploy'
                ]
            )


