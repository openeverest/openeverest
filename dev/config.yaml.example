# Copy this file to config.yaml in dev/ directory and set the values as needed.
enableFrontendBuild: true
# Set to false to skip deploying the OpenEverest Plugin Hub (plugin-hub sub-chart).
enablePluginHub: false
# Set to true to self-install the VictoriaMetrics operator + kube-state-metrics
# in the dev cluster, so Everest's MonitoringConfig/VMAgent flow has something
# to scrape. Off by default, since the 'everest' chart no longer bundles this;
# see percona-helm-charts/charts/pmm/README.md for the equivalent manual setup.
enableMonitoringStack: false
namespaces:
  # List of DB namespaces that will be created automatically
  - name: my-special-place
    # List of BackupStorages that will be created automatically in this namespace
    backupStorages:
      - bs-msp-1
      - bs-msp-2
  - name: the-dark-side
    # List of BackupStorages that will be created automatically in this namespace
    backupStorages:
      - bs-tds-1
      - bs-tds-2
